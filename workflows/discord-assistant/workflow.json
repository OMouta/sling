{
  "schema": "sling.workflow/v1",
  "name": "Discord assistant",
  "description": "Talk to the Sling assistant in Discord. It answers in the same DM or channel, delegates coding work to your machines, and reports back there when tasks finish.",
  "nodes": [
    {
      "id": "message",
      "type": "discord.message_received",
      "version": 1,
      "label": "Discord message",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "installationId": "$discord",
        "scope": "dm",
        "channelIds": [],
        "requireMention": false
      }
    },
    {
      "id": "update",
      "type": "sling.conversation_update",
      "version": 1,
      "label": "Task update",
      "position": {
        "x": 0,
        "y": 220
      },
      "config": {}
    },
    {
      "id": "conversation",
      "type": "state.conversation",
      "version": 1,
      "label": "Conversation",
      "position": {
        "x": 320,
        "y": 100
      },
      "config": {
        "key": "={{ $exists(trigger.key) ? trigger.key : 'discord:' & execution.installationId & ':' & trigger.message.channelId }}",
        "title": "={{ 'Discord: ' & trigger.message.author.username }}"
      }
    },
    {
      "id": "assistant",
      "type": "agent.assistant",
      "version": 1,
      "label": "Assistant",
      "position": {
        "x": 640,
        "y": 100
      },
      "config": {
        "message": "={{ trigger.message.content }}"
      }
    },
    {
      "id": "send",
      "type": "discord.send_message",
      "version": 1,
      "label": "Reply in Discord",
      "position": {
        "x": 900,
        "y": 100
      },
      "config": {
        "installationId": "$discord",
        "channelId": "={{ $exists(trigger.key) ? $split(trigger.key, ':')[2] : trigger.message.channelId }}",
        "approvalButtons": false
      }
    }
  ],
  "edges": [
    {
      "id": "message-conversation",
      "kind": "exec",
      "from": {
        "node": "message",
        "port": "next"
      },
      "to": {
        "node": "conversation",
        "port": "in"
      }
    },
    {
      "id": "update-conversation",
      "kind": "exec",
      "from": {
        "node": "update",
        "port": "next"
      },
      "to": {
        "node": "conversation",
        "port": "in"
      }
    },
    {
      "id": "conversation-assistant",
      "kind": "exec",
      "from": {
        "node": "conversation",
        "port": "next"
      },
      "to": {
        "node": "assistant",
        "port": "in"
      }
    },
    {
      "id": "conversation-data",
      "kind": "data",
      "from": {
        "node": "conversation",
        "port": "conversation"
      },
      "to": {
        "node": "assistant",
        "port": "conversation"
      }
    },
    {
      "id": "x_assistant_send",
      "kind": "exec",
      "from": {
        "node": "assistant",
        "port": "next"
      },
      "to": {
        "node": "send",
        "port": "in"
      }
    },
    {
      "id": "d_assistant_reply_send_content",
      "kind": "data",
      "from": {
        "node": "assistant",
        "port": "reply"
      },
      "to": {
        "node": "send",
        "port": "content"
      }
    }
  ]
}
