{
  "schema": "sling.workflow/v1",
  "name": "Sling Assistant",
  "description": "The assistant you chat with in the web app. It runs commands on your machines, hands coding work to a coding agent there, and reports back when tasks finish.",
  "nodes": [
    {
      "id": "chat",
      "type": "app.chat_message",
      "version": 1,
      "label": "Chat message",
      "position": { "x": 0, "y": 0 },
      "config": {}
    },
    {
      "id": "update",
      "type": "sling.conversation_update",
      "version": 1,
      "label": "Task update",
      "position": { "x": 0, "y": 200 },
      "config": {}
    },
    {
      "id": "conversation",
      "type": "state.conversation",
      "version": 1,
      "label": "Conversation",
      "position": { "x": 320, "y": 100 },
      "config": { "key": "={{ trigger.key }}" }
    },
    {
      "id": "assistant",
      "type": "agent.assistant",
      "version": 1,
      "label": "Assistant",
      "position": { "x": 640, "y": 100 },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "chat-conversation",
      "kind": "exec",
      "from": { "node": "chat", "port": "next" },
      "to": { "node": "conversation", "port": "in" }
    },
    {
      "id": "update-conversation",
      "kind": "exec",
      "from": { "node": "update", "port": "next" },
      "to": { "node": "conversation", "port": "in" }
    },
    {
      "id": "conversation-assistant",
      "kind": "exec",
      "from": { "node": "conversation", "port": "next" },
      "to": { "node": "assistant", "port": "in" }
    },
    {
      "id": "conversation-data",
      "kind": "data",
      "from": { "node": "conversation", "port": "conversation" },
      "to": { "node": "assistant", "port": "conversation" }
    }
  ]
}
