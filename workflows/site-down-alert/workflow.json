{
  "schema": "sling.workflow/v1",
  "name": "Site down alert",
  "description": "Pushes an alert when a site check goes down, and when it's back up.",
  "nodes": [
    {
      "id": "changed",
      "type": "checks.changed",
      "version": 1,
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "check": "",
        "kind": "site",
        "on": "any"
      },
      "label": "A site changed"
    },
    {
      "id": "backUp",
      "type": "core.if",
      "version": 1,
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "condition": "trigger.state = \"up\""
      },
      "label": "Back up?"
    },
    {
      "id": "notifyUp",
      "type": "app.notify",
      "version": 1,
      "position": {
        "x": 600,
        "y": -100
      },
      "config": {
        "title": "={{ trigger.name & \" is back up\" }}",
        "body": "Every health check passes again.",
        "open": "/checks",
        "urgency": "normal",
        "ttlMinutes": 60
      },
      "label": "Back up"
    },
    {
      "id": "notifyDown",
      "type": "app.notify",
      "version": 1,
      "position": {
        "x": 600,
        "y": 100
      },
      "config": {
        "title": "={{ trigger.name & \" is down: \" & trigger.reason }}",
        "body": "={{ \"Failing since \" & trigger.sinceTime & \". Tap to start a chat about it.\" }}",
        "open": "={{ trigger.open }}",
        "urgency": "high",
        "ttlMinutes": 60
      },
      "label": "Down"
    }
  ],
  "edges": [
    {
      "id": "x_changed_backUp",
      "kind": "exec",
      "from": {
        "node": "changed",
        "port": "next"
      },
      "to": {
        "node": "backUp",
        "port": "in"
      }
    },
    {
      "id": "x_backUp_notifyUp",
      "kind": "exec",
      "from": {
        "node": "backUp",
        "port": "true"
      },
      "to": {
        "node": "notifyUp",
        "port": "in"
      }
    },
    {
      "id": "x_backUp_notifyDown",
      "kind": "exec",
      "from": {
        "node": "backUp",
        "port": "false"
      },
      "to": {
        "node": "notifyDown",
        "port": "in"
      }
    }
  ]
}
