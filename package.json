{
  "name": "sling",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=26.13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sling/server --filter @sling/web dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "gen": "pnpm --filter @sling/runner-protocol gen",
    "test:e2e": "cargo build -p sling-runner -p sling-harness-codex -p sling-harness-claude-code && pnpm --filter @sling/server test:e2e",
    "sandbox:image": "docker build -f deploy/sandbox/Dockerfile -t sling-sandbox:dev ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
