# Copy to deploy/.env and fill in.

# The URL people's browsers use to reach Sling. Runners connect to it too.
# Examples: https://sling.example.com, https://sling.your-tailnet.ts.net
SLING_PUBLIC_URL=http://localhost:8080

# Master secret, at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Losing it means stored API keys can't be decrypted.
SLING_SECRET_KEY=

# Password for the bundled Postgres.
POSTGRES_PASSWORD=

# Host port to publish.
SLING_PORT=8080

# Where the port is published: 127.0.0.1 for this computer (and a tunnel) only,
# 0.0.0.0 for the local network too. deploy/setup.sh sets this for you.
SLING_BIND=127.0.0.1

# A tunnel to run next to Sling: tailscale or cloudflare. Empty for none.
# Its secret goes in deploy/tunnel.env (TS_AUTHKEY or TUNNEL_TOKEN), which only
# the tunnel container reads.
COMPOSE_PROFILES=
# Machine name on your tailnet, with the tailscale profile.
# SLING_TAILSCALE_HOSTNAME=sling

LOG_LEVEL=info

# Image sandboxes run when a provider doesn't name its own. Build it with:
#   docker build -f deploy/sandbox/Dockerfile -t sling-sandbox:latest .
# SLING_SANDBOX_IMAGE=sling-sandbox:latest

# GitHub repo, as owner/name, whose releases Sling gets sling-runner from for the
# Runner install command. Defaults to OMouta/sling.
# SLING_RELEASE_REPO=owner/sling

# Only while developing extensions: install unsigned packages and add catalogs on loopback.
# SLING_ALLOW_UNSIGNED_EXTENSIONS=1

# Comma-separated trusted proxy IPs/CIDRs. Empty means direct access.
SLING_TRUSTED_PROXIES=

# Exact internal origins permitted for workflow HTTP nodes. Public-only by default.
SLING_HTTP_ALLOWED_ORIGINS=
# Optional HMAC key, at least 32 characters. Leave unset for bearer-only hooks.
# SLING_WEBHOOK_SECRET=
SLING_WEBHOOK_REQUESTS_PER_MINUTE=60
