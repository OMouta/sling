# Copy to .env for local development. In Docker, set these in deploy/.env.

# Postgres connection string.
DATABASE_URL=postgres://sling:sling@127.0.0.1:5433/sling

# The URL browsers use to reach Sling. In development that's the Vite dev server.
SLING_PUBLIC_URL=http://localhost:5173

# Master secret, at least 32 characters. Generate one with: openssl rand -base64 48
SLING_SECRET_KEY=change-me-to-a-long-random-string-of-48-chars

PORT=8080
LOG_LEVEL=info
