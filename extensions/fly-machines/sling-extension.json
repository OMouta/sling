{
  "format": "sling.extension/v1",
  "id": "fly-machines",
  "name": "Fly Machines",
  "version": "1.0.0",
  "description": "Runs coding tasks in sandboxes on Fly Machines, in a Fly app of your own.",
  "publisher": "Sling",
  "sdk": "^1.0.0",
  "main": "extension.mjs",
  "icon": "icon.svg",
  "permissions": {
    "network": { "hosts": ["api.machines.dev"], "configHosts": ["apiUrl"], "localNetwork": false },
    "approvals": false,
    "sandboxes": true
  },
  "license": "Apache-2.0",
  "homepage": "https://fly.io/docs/machines/"
}
